# Copy to .env and edit. Every variable maps to a field in app/config.py.

# --- App
ENVIRONMENT=local
API_KEY=change-me
PUBLIC_BASE_URL=http://localhost:8000
LENDER_NAME=Northbank
LOG_LEVEL=INFO
# Local testing only: pretend it's Monday 10:00 UTC so calling-hours rules don't block you.
# Remove this line to use the real clock. Refused when ENVIRONMENT=production.
CLOCK_OVERRIDE=2026-11-09T10:00:00Z

# --- Storage (SQLite by default; docker-compose overrides this with Postgres)
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent

# --- Providers: pick an implementation by name (GET /providers lists what is available)
STT_PROVIDER=mock
LLM_PROVIDER=mock
TTS_PROVIDER=mock
VOICE_PROVIDER=console
MESSAGING_PROVIDER=console
CRM_PROVIDER=mock
PAYMENTS_PROVIDER=mock
STATE_STORE=database

# --- Vendor credentials (leave empty while using mocks)
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=8
STT_API_KEY=
STT_MIN_CONFIDENCE=0.75
TTS_API_KEY=
TTS_VOICE=default
VOICE_API_KEY=
MESSAGING_API_KEY=
CRM_BASE_URL=
CRM_API_KEY=
PAYMENTS_API_KEY=

# --- Worker
WORKER_POLL_SECONDS=30
MAX_CONCURRENT_CALLS=5
CALL_TIMEOUT_MINUTES=30
